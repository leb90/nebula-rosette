use "./scene/space.ts" { startSpace }
use "lenis" as Lenis

// The page opens in English. Spanish is there for whoever chooses it, and that choice is remembered.
state lang = "en"
computed T = COPY[lang]

fn showLanguage(next) {
  lang = next
  document.documentElement.lang = next
  document.title = COPY[next].meta.title
}

fn pickLanguage(next) {
  showLanguage(next)
  try {
    localStorage.setItem("lang", next)
  } catch (e) {
  }
}

page Home "/" {
  meta title=COPY.en.meta.title description=COPY.en.meta.description image="/og.png" imageAlt=COPY.en.planetAlt siteName="Rosette Nebula" locale="en_US" themeColor="#06050c" lang="en" theme="dark" jsonld={ "@type": "VideoGame", name: "Rosette Nebula", description: COPY.en.meta.description, genre: ["Role-playing", "Science fiction"], gamePlatform: ["macOS", "Windows"], numberOfPlayers: { "@type": "QuantitativeValue", value: 1 }, author: { "@type": "Person", name: AUTHOR }, inLanguage: ["es", "en"] }

  ref sky

  mount {
    if !inBrowser() {
      return
    }
    let saved = null
    try {
      saved = localStorage.getItem("lang")
    } catch (e) {
    }
    let asked = new URLSearchParams(location.search).get("lang")
    let wanted = asked == "es" || asked == "en" ? asked : saved ?? "en"
    if wanted != lang {
      showLanguage(wanted)
    }
    // The scroll drives most of the page (the sky, the story, the bar), so a wheel's jumps are smoothed into one
    // glide. Lenis also takes the links to sections, landing them below the bar (scroll-padding-top). It steps
    // aside for reduced motion, and touch keeps the device's own scrolling.
    let lenis = new Lenis({ autoRaf: true, anchors: true })
    let space = startSpace(sky)
    cleanup {
      space.stop()
      lenis.destroy()
    }
  }

  column class="page" {
    column class="sky-frame" aria-hidden="true" {
      image "/img/poster.png" alt="" class="sky-poster" width=480 height=300
      canvas ref=sky class="sky"
    }
    Hero
    TopBar
    Premise
    Features
    Terraform
    Nebula
    Status
    Author
    Support
    Faq
    Footer
  }
}
