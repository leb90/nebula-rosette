// The ground and ink of each chapter about how the game plays. The colours come from the game's own ramps.
const FIELD_TONES = ["rust", "ocean", "sand", "ember"]

// mount also runs while the page is prerendered, on a DOM that isn't a browser's.
fn inBrowser() {
  return !globalThis.__artSSR && !globalThis.__artStatic
}

