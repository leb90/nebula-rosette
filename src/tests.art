// The page opens in English; a test that reads Spanish chooses it first.

test "the first screen says what this is and opens as the menu" {
  open "/"
  click "ES"
  see "Nebula Rosette"
  see "Apoyar en Patreon"
  see "La historia"
  see "Quedan pocas naves"
}

test "the page opens in English" {
  open "/"
  see "Back it on Patreon"
}

test "changing the language changes the page" {
  open "/"
  click "ES"
  see "Cómo se juega"
  click "EN"
  see "How it plays"
  see "Few ships left"
  click "ES"
  see "Cómo se juega"
}

test "the terraforming stages change the world" {
  open "/"
  click "ES"
  see "Mundo muerto"
  click "Vida"
  see "Las primeras algas tiñen las costas."
  click "Agua"
  see "Cometas de hielo llenan de mares las partes bajas."
}

test "the support band asks for backing on Patreon in both languages" {
  open "/"
  click "ES"
  see "Apoyá Nebula Rosette en Patreon."
  click "EN"
  see "Back Nebula Rosette on Patreon."
}

test "the end of the page says it is made with ArtScript" {
  open "/"
  click "ES"
  see "Hecho en ArtScript"
  click "EN"
  see "Made with ArtScript"
}

test "each option of a decision shows what it costs" {
  open "/"
  notSee "They let you through"
  click "Negotiate"
  see "They let you through"
  click "Run"
  see "One ship of the fleet"
  notSee "They let you through"
}

test "the decision works in Spanish too" {
  open "/"
  click "ES"
  click "Negociar"
  see "Te dejan pasar"
}
